<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_prayer_background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☾ نور الصلاة"
            android:textColor="#E4C77F"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="عمّان، الأردن"
            android:textColor="#D3DDCF"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next_prayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="الصلاة القادمة: الفجر"
        android:textColor="#F5F0DF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="1dp">

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05:12"
            android:textColor="#E4C77F"
            android:textSize="25sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        android:background="#607B6755"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="الفجر\n05:12"
            android:textColor="#F5F0DF"
            android:textSize="10sp"/>

        <TextView
            android:id="@+id/widget_sunrise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="الشروق\n06:37"
            android:textColor="#D3DDCF"
            android:textSize="10sp"/>

        <TextView
            android:id="@+id/widget_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="الظهر\n11:42"
            android:textColor="#F5F0DF"
            android:textSize="10sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/widget_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="العصر\n14:50"
            android:textColor="#F5F0DF"
            android:textSize="10sp"/>

        <TextView
            android:id="@+id/widget_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="المغرب\n16:30"
            android:textColor="#F5F0DF"
            android:textSize="10sp"/>

        <TextView
            android:id="@+id/widget_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="العشاء\n17:50"
            android:textColor="#F5F0DF"
            android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
